# SERVER-ONLY LOCAL FILE TEMPLATE. Copy to supabase/functions/.env and fill locally.
# Never commit the copied file. Rotate the previously shared Sandbox secret first.
PLAID_ENV=sandbox
KEEL_LIVE_SYNC_ENABLED=false
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
BANK_PROVIDER=simulator
AI_PROVIDER=fixture
ALLOW_REAL_PII=false
# Optional cloud model key — leave blank during Stage 0–1.
AI_API_KEY=
# Named automations secret for worker/scheduled (LOCAL value is generated by
# `pnpm provision:local`; the CLOUD named key is a human checkpoint).
# SUPABASE_SECRET_KEYS={"automations":"sb_secret_..."}
# Webhook verification key. Stage 1A tests inject a fixture PUBLIC JWK here;
# live Plaid key fetching arrives in stage 1C.
# PLAID_WEBHOOK_JWK={"kty":"EC","crv":"P-256",...public JWK json...}
# Credential-envelope KEK (local value generated by `pnpm provision:local`;
# the CLOUD KEK is a human checkpoint).
# KEEL_CREDENTIAL_KEK=<base64 32 bytes>
# KEEL_CREDENTIAL_KEK_VERSION=1
