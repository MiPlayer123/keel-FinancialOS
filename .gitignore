# --- Secret boundary (CLAUDE.md Law 12) ---
# Server-only env files: never commit filled copies.
.env
.env.*
!.env.example
!.env.*.example
supabase/.env.remote
supabase/functions/.env
apps/web/.env.local

# --- Dependencies / build output ---
node_modules/
.pnpm-store/
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo
.turbo/

# --- Supabase local state ---
supabase/.branches/
supabase/.temp/
supabase/.env

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# --- Backups (must never be committed) ---
backups/
*.dump
*.sql.gz

# Generated artifacts
supabase/functions/_shared/vendor/
.env.local-automations

# local Claude Code state (settings, session artifacts) — but the
# versioned pipeline skills under .claude/skills/ are project files
.claude/*
!.claude/skills/
docs/superpowers/
.screenshots/
