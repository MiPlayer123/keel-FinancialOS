{
  "name": "keel",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:functions": "node scripts/build-functions.mjs",
    "provision:local": "node scripts/dev/provision-local-env.mjs",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "fast-check": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "esbuild": "^0.25.0",
    "@supabase/supabase-js": "^2.110.0",
    "jose": "^6.0.0"
  }
}
