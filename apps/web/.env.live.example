# KEEL web — LIVE (cloud Supabase) config for `pnpm dev` (and production).
#
# Copy this file to `apps/web/.env.live` and fill with the CLOUD project values.
# Only publishable, browser-safe config belongs here (never secret keys — Law 12).
#
#   pnpm dev        → runs the web app against LIVE (cloud) Supabase (this file)
#   pnpm dev:local  → runs against the LOCAL Supabase stack (uses .env.local)
#
# Get these from the cloud project (Supabase dashboard → Project Settings → API):
#   - Project URL
#   - Publishable / anon key (browser-safe)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
