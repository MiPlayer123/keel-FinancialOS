# KEEL public browser configuration (INFRA.md §11.1).
# These values are intentionally client-visible. Everything exposed through them
# must still be protected by RLS + KEEL authorization. No secret ever goes here.

# --- Cloud (Supabase Free project, per docs/17) ---
NEXT_PUBLIC_SUPABASE_URL=https://yrbteeownwjhcushwaga.supabase.co
# Publishable key (sb_publishable_...) — public by design, but not included in the
# spec corpus and the project is not visible from the connected Supabase account.
# ⚑ human: confirm project binding, then paste the publishable key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Local development (values printed by `supabase start`) ---
# Copy this file to apps/web/.env.local and use the local values while developing:
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<local anon/publishable key from `supabase start`>
