# KEEL public browser configuration (INFRA.md §11.1).
# These values are intentionally client-visible. Everything exposed through them
# must still be protected by RLS + KEEL authorization. No secret ever goes here.

# --- Cloud (Supabase Free project, per docs/17) ---
NEXT_PUBLIC_SUPABASE_URL=https://yrbteeownwjhcushwaga.supabase.co
# Publishable key — public by design (INFRA §11.1); RLS + KEEL authz protect
